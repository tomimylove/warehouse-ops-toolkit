# Copy to .env and fill in for local development.
# Postgres free tier (Supabase/Neon) connection string, e.g.:
# postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/warehouse_ops"
# Supabase pooled connections: DATABASE_URL is the transaction-mode pooler
# (port 6543, used at runtime), DIRECT_URL is the session-mode pooler or a
# direct connection (port 5432, used by Prisma for migrations).
DIRECT_URL="postgresql://postgres:changeme@localhost:5432/warehouse_ops"
PORT=3000
