generator client {
  provider = "prisma-client-js"
}

// Switched from SQL Server to Postgres (free tier — Supabase/Neon, no
// Azure AD tenant to fight with). Dropped the SQL-Server-only bits this
// forced: @db.NVarChar sizing and the NoAction cascade workarounds below
// — Postgres allows more than one cascade path into the same table, so
// these relations are just the behavior we actually want now.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Announcements")
}

// Granular RBAC — no fixed admin/editor/reader tiers. A Role is just a
// named bundle of permission keys ("announcements:create", "hse:edit", ...);
// a module ships new keys as it's built, never a schema change here. A user
// with no matching key for a module doesn't just lose its buttons — the
// sidebar entry and the route itself are both gated (see apps/web
// usePermissions()/RequirePermission), not merely hidden UI.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@map("Users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  // The role newly-seen users are assigned automatically (see
  // UsersService.findOrCreateByEmail) — editable like any other role
  // (rename it, change its permissions), just never deleted while it
  // holds this flag. Exactly one row should have it true; enforced in
  // UsersService/seed, not a DB constraint.
  isDefault   Boolean          @default(false)
  users       User[]
  permissions RolePermission[]

  @@map("Roles")
}

// One row per granted permission key — deliberately a flat string, not an
// enum: adding a permission for a new module is a data seed, not a
// migration. "<module>:<action>" convention (e.g. "announcements:pin").
model RolePermission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  key    String

  @@unique([roleId, key])
  @@map("RolePermissions")
}

// Tasks module (specs/ARCHITECTURE.md, раздел 12) — YouGile-inspired:
// Project -> Board (tabs within a project) -> Column -> Task, all through
// one Task table. Board/Gantt/Calendar are just views over the same rows,
// not separate models. A Task with no boardId is a personal Note — same
// table, same API, just filtered to its author; converting a note into a
// real task is a plain boardId/columnId update, not a data migration.
model Project {
  id        String   @id @default(cuid())
  name      String
  boards    Board[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Projects")
}

model Board {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  columns   Column[]
  tasks     Task[]
  createdAt DateTime @default(now())

  @@map("Boards")
}

model Column {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  order   Int    @default(0)
  tasks   Task[]

  @@map("Columns")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  boardId     String?
  board       Board?    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // Deleting a column un-assigns its tasks rather than deleting them.
  columnId    String?
  column      Column?   @relation(fields: [columnId], references: [id], onDelete: SetNull)
  order       Int       @default(0)
  authorId    String
  // Deleting a task detaches (not deletes) its subtasks.
  parentId    String?
  parent      Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks    Task[]    @relation("Subtasks")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("Tasks")
}
