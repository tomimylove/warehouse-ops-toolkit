generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String   @db.NVarChar(200)
  body      String   @db.NVarChar(Max)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Announcements")
}
