generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the rhel targets are for Netlify Functions'
  // AWS Lambda runtime (Amazon Linux 2023, with AL2 as a fallback).
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

// Switched from SQL Server to Postgres (free tier — Supabase/Neon, no
// Azure AD tenant to fight with). Dropped the SQL-Server-only bits this
// forced: @db.NVarChar sizing and the NoAction cascade workarounds below
// — Postgres allows more than one cascade path into the same table, so
// these relations are just the behavior we actually want now.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Id into the client-side curated cover gallery (apps/web), not a URL —
  // keeps "pick a cover" from needing file storage or a third-party photo
  // API wired up. Null means "no cover chosen"; the feed then derives a
  // stable pseudo-random one from the announcement id, so a post still
  // gets a cover without one being stored for it.
  coverId String?

  // Team-limited visibility (specs/features/01-announcements.md, Решение 91):
  // visible to everyone by default; unchecking "Limit to specific teams" in
  // the form just means `teams` is empty while this stays true. The
  // restriction only ever applies to a plain reader — anyone with
  // announcements:edit sees every announcement regardless of their own team.
  visibleToAll Boolean            @default(true)
  teams        AnnouncementTeam[]
  reads        AnnouncementRead[]
  versions     AnnouncementVersion[]
  comments     AnnouncementComment[]

  @@map("Announcements")
}

// Flat comments (specs/DATA_SCHEMA.md, "Comment") — plain text, no nested
// replies for v1. Kept directly on Announcement rather than the old
// entityType/entityId polymorphic shape: Announcements is still the only
// consumer, so a real foreign key is simpler than designing a generic
// comments system nothing else uses yet.
model AnnouncementComment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  text           String
  createdAt      DateTime     @default(now())

  @@map("AnnouncementComments")
}

model AnnouncementTeam {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([announcementId, teamId])
  @@map("AnnouncementTeams")
}

// Per-record read tracking, not per-module (specs/DATA_SCHEMA.md, "ReadMark",
// Решение 46) — a module-wide "last seen" timestamp cleared every unread
// badge the moment any one record was opened, which read wrong in practice.
// Existence of a row = this user has opened this announcement.
model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@map("AnnouncementReads")
}

// Snapshot-on-save history (specs/DATA_SCHEMA.md, "История версий") — every
// edit appends the PREVIOUS state here before overwriting Announcement, so
// "History" can list and restore past versions. `activity`-only rows (no
// snapshot) cover events a plain save-diff can't catch, like an attachment
// being added outside the edit form. Pruned to the last 10 per announcement
// by the service, not a DB constraint — this is accidental-edit protection,
// not a full audit log.
model AnnouncementVersion {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  // Full { title, body, pinned, ... } copy of the record just before this
  // save; null for an activity-only row.
  snapshot       Json?
  changes        String[]
  activity       Boolean      @default(false)
  message        String?
  savedById      String
  savedBy        User         @relation(fields: [savedById], references: [id])
  savedAt        DateTime     @default(now())

  @@map("AnnouncementVersions")
}

// Shared reference list — same role Staff's own Team directory will grow
// into (specs/DATA_SCHEMA.md, "Team, Company"), Announcements is just the
// first consumer. admin/editor manage it, everyone reads it.
model Team {
  id            String             @id @default(cuid())
  name          String             @unique
  createdAt     DateTime           @default(now())
  users         User[]
  announcements AnnouncementTeam[]

  @@map("Teams")
}

// Granular RBAC — no fixed admin/editor/reader tiers. A Role is just a
// named bundle of permission keys ("announcements:create", "hse:edit", ...);
// a module ships new keys as it's built, never a schema change here. A user
// with no matching key for a module doesn't just lose its buttons — the
// sidebar entry and the route itself are both gated (see apps/web
// usePermissions()/RequirePermission), not merely hidden UI.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  // Nullable: a user with no team only ever sees visibleToAll content —
  // same "not every account has to be slotted in" allowance the old FSA
  // schema gave StaffMember.team.
  teamId                String?
  team                  Team?                  @relation(fields: [teamId], references: [id])
  announcementReads     AnnouncementRead[]
  announcementVersions  AnnouncementVersion[]
  announcementsAuthored Announcement[]
  announcementComments  AnnouncementComment[]

  @@map("Users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  // The role newly-seen users are assigned automatically (see
  // UsersService.findOrCreateByEmail) — editable like any other role
  // (rename it, change its permissions), just never deleted while it
  // holds this flag. Exactly one row should have it true; enforced in
  // UsersService/seed, not a DB constraint.
  isDefault   Boolean          @default(false)
  users       User[]
  permissions RolePermission[]

  @@map("Roles")
}

// One row per granted permission key — deliberately a flat string, not an
// enum: adding a permission for a new module is a data seed, not a
// migration. "<module>:<action>" convention (e.g. "announcements:pin").
model RolePermission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  key    String

  @@unique([roleId, key])
  @@map("RolePermissions")
}

// Tasks module (specs/ARCHITECTURE.md, раздел 12) — YouGile-inspired:
// Project -> Board (tabs within a project) -> Column -> Task, all through
// one Task table. Board/Gantt/Calendar are just views over the same rows,
// not separate models. A Task with no boardId is a personal Note — same
// table, same API, just filtered to its author; converting a note into a
// real task is a plain boardId/columnId update, not a data migration.
model Project {
  id        String   @id @default(cuid())
  name      String
  boards    Board[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Projects")
}

model Board {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  columns   Column[]
  tasks     Task[]
  createdAt DateTime @default(now())

  @@map("Boards")
}

model Column {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  order   Int    @default(0)
  tasks   Task[]

  @@map("Columns")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  boardId     String?
  board       Board?    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // Deleting a column un-assigns its tasks rather than deleting them.
  columnId    String?
  column      Column?   @relation(fields: [columnId], references: [id], onDelete: SetNull)
  order       Int       @default(0)
  authorId    String
  // Deleting a task detaches (not deletes) its subtasks.
  parentId    String?
  parent      Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks    Task[]    @relation("Subtasks")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("Tasks")
}
